# Google Apps Script Web App URL that appends a row to your registrations
# sheet. A normal Google Sheets "share" link will NOT work here — it must be
# the /exec URL from deploying an Apps Script Web App. See README.md for the
# one-time setup steps.
ELEFIN_SHEET_WEBHOOK_URL=

# Same idea, for the homepage Contact section's enquiry form — a separate
# Apps Script Web App URL, typically deployed from its own sheet/tab. See
# README.md.
CONTACT_SHEET_WEBHOOK_URL=
